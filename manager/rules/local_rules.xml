<group name="syslog,abuseipdb,custom_sysmon,windows,playbook_rules,tuning,sudo,sshd,whitelist,local_brute_force">

  <rule id="100041" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(services\.exe|WmiPrvSE\.exe)$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd\.exe|powershell\.exe|PSEXESVC\.exe)$</field>
    <description>Suspicious Lateral Movement: Phát hiện tiến trình thực thi lệnh từ xa (Impacket PsExec/WMI detected)</description>
    <mitre>
      <id>T1021.002</id>
      <id>T1047</id>
      <id>T1569.002</id>
    </mitre>
  </rule>

  <rule id="100031" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(\\Run|\\RunOnce)</field>
    <description>Privilege Escalation: Persistence via Registry Run/RunOnce keys</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <rule id="100030" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^8$</field>
    <description>Privilege Escalation/Lateral Movement: Process Injection (CreateRemoteThread) detected</description>
    <mitre>
      <id>T1055</id>
    </mitre>
  </rule>

  <rule id="100050" level="10">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^22$</field>
    <field name="win.eventdata.queryName" type="pcre2">(?i)(ngrok\.io|pastebin\.com|githubusercontent\.com|mega\.nz)</field>
    <description>Data Exfiltration: DNS Query to suspicious domain</description>
    <mitre>
      <id>T1048</id>
    </mitre>
  </rule>

  <rule id="100051" level="10">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell\.exe|cmd\.exe|wscript\.exe)</field>
    <options>no_full_log</options>
    <description>Data Exfiltration: Network connection initiated by script engine/shell</description>
  </rule>

  <rule id="100040" level="6">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.destinationPort">^445$</field>
    <description>Playbook 04: Ghi nhận kết nối mạng vào cổng SMB (Port 445)</description>
  </rule>

  <rule id="100070" level="10">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell\.exe|certutil\.exe|mshta\.exe)</field>
    <description>Suspicious Process Execution: LOLBins (powershell, certutil, mshta) detected</description>
    <mitre>
      <id>T1059</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100001" level="10">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe)</field>
    <description>Suspicious Process Execution: $(win.eventdata.image)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100002" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^1$|^11$</field> <field name="win.eventdata.image" type="pcre2">(?i)(mimikatz\.exe|procdump\.exe)</field>
    <description>Credential Dumping tool detected: $(win.eventdata.image)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <rule id="100004" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^1$</field> <field name="win.eventdata.image" type="pcre2">(?i)(ngrok\.exe)</field>
    <description>Data Exfiltration: ngrok tool detected</description>
    <mitre>
      <id>T1048</id>
    </mitre>
  </rule>

  <rule id="100100" level="3">
    <if_group>windows</if_group>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">^11$</field>
    <time>18:00 - 08:00</time>
    <description>Insider Threat tracking: File created/copied outside business hours</description>
  </rule>

  <rule id="100101" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <description>Insider Threat Alert: Massive file manipulation outside business hours!</description>
    <mitre>
      <id>T1020</id>
    </mitre>
  </rule>

  <rule id="100099" level="12">
    <field name="integration">abuseipdb</field>
    <description>AbuseIPDB: Phat hien IP doc hai co do tin cay cao!</description>
  </rule>

  <rule id="100250" level="10" frequency="3" timeframe="180">
    <if_matched_sid>2501</if_matched_sid>
    <match>gdm-password</match>
    <description>LOCAL BRUTE-FORCE: Phat hien nhieu lan nhap sai mat khau tren man hinh GUI</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100512" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <description>sshd: brute force trying to get access to the system.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100200" level="0">
    <if_sid>40101,40111</if_sid> <srcip>192.168.0.0/24</srcip>
    <description>Tuning: Whitelist Nmap scan tu mang WiFi noi bo</description>
  </rule>

  <rule id="100201" level="0">
    <if_sid>5402,5403</if_sid>
    <description>Tuning: Loai bo canh bao SUDO tu tai khoan quan tri.</description>
  </rule>

  <rule id="100202" level="0">
    <if_sid>5715,5722</if_sid>
    <description>Tuning: Loai bo log SSH Preauth (connection closed).</description>
  </rule>
</group>

<group name="linux,sysmon">
  <rule id="200150" level="3">
    <decoded_as>sysmon-linux</decoded_as>
    <field name="system.eventId">\.+</field>
    <group>sysmon_event1</group>
    <description>Sysmon For Linux Event</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200151" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^1$</field>
    <description>Sysmon - Event 1: Process creation $(eventdata.image)</description>
    <group>sysmon_event1</group>
    <mitre>
      <id>T1204</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200152" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^3$</field>
    <description>Sysmon - Event 3: Network connection by $(eventdata.image)</description>
    <group>sysmon_event3</group>
    <mitre>
      <id>T1043</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200153" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^5$</field>
    <description>Sysmon - Event 5: Process terminated $(eventdata.image)</description>
    <group>sysmon_event5</group>
    <mitre>
      <id>T1204</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200154" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^9$</field>
    <description>Sysmon - Event 9: Raw Access Read by $(eventdata.image)</description>
    <group>sysmon_event9</group>
    <mitre>
      <id>T1204</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200155" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^11$</field>
    <description>Sysmon - Event 11: FileCreate by $(eventdata.image)</description>
    <group>sysmon_event_11</group>
    <mitre>
      <id>T1044</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200156" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^16$</field>
    <description>Sysmon - Event 16: Sysmon config state changed $(Event.EventData.Data.Configuration)</description>
    <group>sysmon_event_16</group>
    <mitre>
      <id>T1562</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200157" level="3">
    <if_sid>200150</if_sid>
    <field name="system.eventId">^23$</field>
    <description>Sysmon - Event 23: FileDelete (A file delete was detected) by $(eventdata.image)</description>
    <group>sysmon_event_23</group>
    <mitre>
      <id>T1107</id>
      <id>T1485</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200200" level="1">
    <if_sid>200152</if_sid>
    <field name="eventdata.image">wazuh-agentd$</field>
    <description>Sysmon - Event 3: Network connection by $(eventdata.image)</description>
    <group>sysmon_event3</group>
    <mitre>
      <id>T1107</id>
      <id>T1485</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200201" level="1">
    <if_sid>200155</if_sid>
    <field name="eventdata.image">wazuh-agentd$</field>
    <description>Sysmon - Event 11: FileCreate by $(eventdata.image)</description>
    <group>sysmon_event_11</group>
    <mitre>
      <id>T1107</id>
      <id>T1485</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="200202" level="1">
    <if_sid>200157</if_sid>
    <field name="eventdata.image">wazuh-agentd$</field>
    <description>Sysmon - Event 23: FileDelete (A file delete was detected) by $(eventdata.image)</description>
    <group>sysmon_event_23</group>
    <mitre>
      <id>T1107</id>
      <id>T1485</id>
    </mitre>
    <options>no_full_log</options>
  </rule>
</group>

<group name="misp,threat_intel,ioc_match">
  <rule id="100901" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^3$</field>
    <list field="win.eventdata.destinationIp" lookup="match_key">etc/lists/misp-ip-blocklist</list>
    <description>MISP IOC: Sysmon outbound connection to blocklisted IP $(win.eventdata.destinationIp)</description>
    <group>misp,threat_intel,ioc_match</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100903" level="13">
    <if_sid>200152</if_sid>
    <list field="eventdata.destinationIp" lookup="match_key">etc/lists/misp-ip-blocklist</list>
    <description>MISP IOC: Linux Sysmon network connection to blocklisted IP</description>
    <group>misp,threat_intel,ioc_match</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100920" level="14">
    <if_group>syscheck</if_group>
    <list field="syscheck.sha256_after" lookup="match_key">etc/lists/misp-hash-blocklist</list>
    <description>MISP IOC: FIM detected blocklisted hash at $(syscheck.path)</description>
    <group>misp,threat_intel,ioc_match</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100922" level="15">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <list field="win.eventdata.hashes" lookup="match_key">etc/lists/misp-hash-blocklist</list>
    <description>MISP IOC: Process with blocklisted hash — $(win.eventdata.image)</description>
    <group>misp,threat_intel,ioc_match</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100910" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^22$</field>
    <list field="win.eventdata.queryName" lookup="match_key">etc/lists/misp-domain-blocklist</list>
    <description>MISP IOC: DNS query for blocklisted domain $(win.eventdata.queryName)</description>
    <group>misp,threat_intel,ioc_match</group>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>
</group>

<group name="web,juiceshop,owasp_top_10">

  <rule id="100300" level="0">
    <decoded_as>juiceshop-web</decoded_as>
    <description>OWASP Juice Shop Web Access Base</description>
  </rule>

  <rule id="100301" level="12">
    <if_sid>100300</if_sid>
    <url>%27|%22|UNION|SELECT|DROP|INSERT|--</url>
    <description>Juice Shop: SQL Injection attempt in URI</description>
    <mitre><id>T1190</id></mitre>
    <group>sqli,attack</group>
  </rule>

  <rule id="100305" level="12">
    <if_sid>100300</if_sid>
    <field name="referer" type="pcre2">%27|%22|UNION|SELECT|DROP|INSERT|--</field>
    <description>Juice Shop: SQL Injection attempt in Referer</description>
    <mitre><id>T1190</id></mitre>
    <group>sqli,attack</group>
  </rule>

  <rule id="100302" level="11">
    <if_sid>100300</if_sid>
    <url>%3Cscript|%3Ciframe|%3Csvg|%3Cimg|javascript:|onerror=|onload=</url>
    <description>Juice Shop: XSS attempt in URI</description>
    <mitre><id>T1190</id></mitre>
    <group>xss,attack</group>
  </rule>

  <rule id="100306" level="11">
    <if_sid>100300</if_sid>
    <field name="referer" type="pcre2">%3Cscript|%3Ciframe|%3Csvg|%3Cimg|javascript:|onerror=|onload=</field>
    <description>Juice Shop: XSS attempt in Referer header</description>
    <mitre><id>T1190</id></mitre>
    <group>xss,attack</group>
  </rule>

  <rule id="100303" level="10">
    <if_sid>100300</if_sid>
    <url>%2E%2E%2F|%2E%2E%5C|\.\./|\.\.\\</url>
    <description>Juice Shop: Directory Traversal / LFI attempt</description>
    <mitre><id>T1083</id></mitre>
    <group>lfi,attack</group>
  </rule>

  <rule id="100304" level="6">
    <if_sid>100300</if_sid>
    <status>^4|^5</status>
    <description>Juice Shop: HTTP error response detected</description>
    <group>web_error</group>
  </rule>

</group>
