    network_context = get_network_context(alert)
    ioc_hashes = extract_ioc_hashes(alert)

    # 2. Thực hiện làm giàu dữ liệu Threat Intel ngay lập tức (On-the-fly Enrichment)
    intel_data = get_abuseipdb_info(src_ip)

    # 3. Gọi Gemini để phân tích incident (thay cho Llama 3.1 qua Ollama)
    ai_json = None
    try:
        ai_json = call_gemini_json(
            SYSTEM_PROMPT_INCIDENT_ANALYSIS_V1,
            build_incident_user_prompt(alert, intel_data),
            temperature=0.2,
            response_schema=INCIDENT_RESPONSE_SCHEMA,
        )
        if not isinstance(ai_json, dict):
            logging.error("Gemini trả JSON hợp lệ nhưng không phải object. Dùng fallback.")
            ai_json = None
    except Exception as e:
        logging.error(f"Lỗi gọi Gemini hoặc parse JSON: {e}")
        ai_json = None

    # Fallback dự phòng nếu AI chết máy hoặc phản hồi sai định dạng
    if not ai_json:
        ai_json = {
            "severity": "High" if int(rule_level) >= 10 else "Medium",
            "affected_user": "N/A",
            "attack_summary": f"Security event triggered by rule {rule_id}: {description}",
            "mitre_techniques": ["T1059"],
            "recommended_actions": ["monitor"],
        }

    # 4b. FIX #3 + #6: validate & enforce lại toàn bộ output AI trước khi dùng
    severity = safe_severity(ai_json.get("severity", "Unknown"))
    mitre_techniques = ai_json.get("mitre_techniques", [])
    if not isinstance(mitre_techniques, list):
        mitre_techniques = []
    recommended_actions = enforce_failsafe_actions(
        ai_json.get("recommended_actions", ["monitor"]), src_ip
    )

    # 4c. AUTO-BLOCK: nếu AbuseIPDB score đủ cao + đủ report, ép action = block_ip
    # và đánh dấu để xử lý auto-execute (không chờ Approve) ở bước dưới.
    auto_block = should_auto_block(intel_data, src_ip)
    if auto_block:
        recommended_actions = ["block_ip"]

    # 5. Khớp dữ liệu sinh Incident ID và lưu file JSON Nghiệm Thu
    incident_id = get_next_incident_id()

    final_report = {
        "incident_id": incident_id,
        "rule_id": str(rule_id),
        "rule_level": rule_level,
        "severity": severity,
        "patient_zero": {"hostname": hostname, "ip": victim_ip},
        "affected_user": ai_json.get("affected_user", "N/A"),
        "attack_summary": ai_json.get("attack_summary", ""),
        "ioc": {"hash": ioc_hashes, "ip": [src_ip] if src_ip != "N/A" else [], "domain": []},
        "threat_verdict": intel_data["verdict"],
        "mitre_techniques": mitre_techniques,
        # Thêm tên kỹ thuật kèm mã — analyst đọc report không cần tra cứu MITRE riêng.
        "mitre_techniques_detail": [
            {"id": t, "name": MITRE_TECHNIQUE_NAMES.get(t, "Không xác định")}
            for t in mitre_techniques
        ],
        "timeline": [f"{timestamp} - {description} from IP {src_ip}"],
        "recommended_actions": recommended_actions,
        # FIX #5: lưu sẵn action + target trong file report để backend đọc lại
        # thay vì phải nhét hết vào callback_data (giới hạn 64 byte của Telegram).
        "pending_action": {
            "action": recommended_actions[0] if recommended_actions else "monitor",
            "target_ip": src_ip if (recommended_actions and recommended_actions[0] == "block_ip") else victim_ip,
            "alert_id": alert_id,
            # "auto_executed": đã tự động chặn rồi, analyst chỉ cần biết, không cần bấm gì.
            # "pending": cần analyst bấm Approve thì soar_backend.py mới thực thi.
            "status": "auto_executed" if auto_block else "pending",
        },
    }

    # 5b. Nếu đạt điều kiện auto-block: kích hoạt chặn NGAY, trước khi gửi Telegram,
    # để phần thông báo bên dưới phản ánh đúng thực tế (đã chặn hay đang chờ duyệt).
    if auto_block:
        blocked_ok = trigger_active_response_block(src_ip, intel_data, incident_id)
        if not blocked_ok:
            # Ghi log để không im lặng nếu lỡ không kích hoạt được — vẫn tiếp tục
            # gửi Telegram để analyst biết mà xử lý tay.            
           logging.error(f"Auto-block THẤT BẠI cho {src_ip}, incident {incident_id} — cần xử lý thủ công.")

    # =====================================================================
    # LỚP ÁO GIÁP SCHEMA VALIDATION (CỦA KHOA)
    # =====================================================================
    REPORT_SCHEMA = {
        "type": "object",
        "properties": {
            "incident_id": {"type": "string"},
            "rule_id": {"type": "string"},
            "rule_level": {"type": ["integer", "string", "number"]},
            "severity": {"type": "string", "enum": ["Critical", "High", "Medium", "Low", "Unknown", "N/A"]},
            "patient_zero": {
                "type": "object",
                "properties": {"hostname": {"type": "string"}, "ip": {"type": "string"}},
                "required": ["hostname", "ip"],
                "additionalProperties": False
            },
            "affected_user": {"type": "string"},
            "attack_summary": {"type": "string"},
            "ioc": {
                "type": "object",
                "properties": {
                    "hash": {"type": "array", "items": {"type": "string"}},
                    "ip": {"type": "array", "items": {"type": "string"}},
                    "domain": {"type": "array", "items": {"type": "string"}}
                },
                "required": ["hash", "ip", "domain"],
                "additionalProperties": False
            },
            "threat_verdict": {"type": "string"},
            "mitre_techniques": {"type": "array", "items": {"type": "string"}},
            "mitre_techniques_detail": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {"id": {"type": "string"}, "name": {"type": "string"}},
                    "required": ["id", "name"],
                    "additionalProperties": False
                }
            },
            "timeline": {"type": "array", "items": {"type": "string"}},
            "recommended_actions": {"type": "array", "items": {"type": "string"}},
            # UPDATE: Bổ sung trường pending_action của SOAR Backend để Schema không chửi
            "pending_action": {
                "type": "object",
                "properties": {
                    "action": {"type": "string"},
                    "target_ip": {"type": "string"},
                    "alert_id": {"type": "string"},
                    "status": {"type": "string"},
                    "resolution": {"type": "string"},
                    "resolved_by": {"type": "string"}
                },
                "required": ["action", "target_ip", "alert_id", "status"],
                "additionalProperties": False
            }
        },
        "required": [
            "incident_id", "rule_id", "rule_level", "severity", "patient_zero", "affected_user",
            "attack_summary", "ioc", "threat_verdict", "mitre_techniques", "mitre_techniques_detail",
            "timeline", "recommended_actions", "pending_action"
        ],
        "additionalProperties": False
    }

    try:
        validate(instance=final_report, schema=REPORT_SCHEMA)
    except ValidationError as e:
        logging.error(f"[TN3] Schema validation failed for {incident_id}: {e.message}")
    # =====================================================================

    # Ghi tệp cứng để phục vụ script validate_ai_json.py của Leader
    try:
        report_path = os.path.join(REPORTS_DIR, f"{incident_id}.json")
        with open(report_path, "w", encoding="utf-8") as rf:
            json.dump(final_report, rf, indent=2, ensure_ascii=False)
    except Exception as e:
        logging.error(f"Không thể lưu file incident report: {e}")

    # 6. Thiết kế giao diện Telegram — bố cục mới: bỏ ký tự vẽ cây ASCII (dễ vỡ
    # dòng trên mobile), thay bằng emoji + nhóm nội dung theo thứ tự ưu tiên đọc:
    # mức độ nghiêm trọng -> host/user/thời gian -> diễn biến -> MITRE -> threat
    # intel -> hành động đề xuất -> raw log (ẩn trong spoiler, không bắt buộc đọc).
    severity_emoji = {
        "Critical": "🔴", "High": "🟠", "Medium": "🟡",
        "Low": "🟢", "Unknown": "⚪", "N/A": "⚪",
    }.get(final_report["severity"], "⚪")

    mitre_display_list = format_mitre_techniques(final_report["mitre_techniques"])
    mitre_str = ", ".join(mitre_display_list) if mitre_display_list else "N/A"
    action_vi = ", ".join(ACTION_LABELS_VI.get(a, a) for a in final_report["recommended_actions"])

    # FIX #2: escape mọi giá trị nội suy vào HTML để tránh vỡ parse_mode="HTML"
    # hoặc bị chèn tag từ dữ liệu log không đáng tin cậy.
    e_description = html.escape(str(description))
    e_hostname = html.escape(str(hostname))
    e_victim_ip = html.escape(str(victim_ip))
    e_timestamp = html.escape(format_timestamp_vn(str(timestamp)))
    e_summary = html.escape(str(final_report["attack_summary"]))
    e_affected_user = html.escape(str(final_report["affected_user"]))
    e_src_ip = html.escape(str(src_ip))
    e_verdict = html.escape(str(final_report["threat_verdict"]))
    e_mitre = html.escape(mitre_str)
    e_action_vi = html.escape(action_vi)
    e_raw_log = html.escape(raw_log_excerpt) if raw_log_excerpt else None
    e_network = html.escape(network_context) if network_context else None
    e_is_tor = (
        ("Có ⚠️" if intel_data.get("is_tor") else "Không")
        if intel_data.get("status") == "success"
        else "N/A (chưa tra cứu được)"
    )
    e_usage_type = (
        html.escape(str(intel_data.get("usageType", "Unknown")))
        if intel_data.get("status") == "success"
        else "N/A"
    )
    e_hashes = html.escape(", ".join(final_report["ioc"]["hash"])) if final_report["ioc"]["hash"] else None

    if auto_block:
        header_line = f"<b>ĐÃ TỰ ĐỘNG CHẶN</b> — Rule Level {rule_level}"
    else:
        header_line = f"{severity_emoji} <b>{html.escape(final_report['severity'].upper())}</b> — Rule Level {rule_level}"

    lines = [
        header_line,
        e_description,
        "",
        f"<b>Host:</b> {e_hostname} (<code>{e_victim_ip}</code>)",
        f"<b>User:</b> {e_affected_user}",
        f"<b>Thời gian:</b> {e_timestamp}",
    ]
    if e_network:
        lines.append(f"<b>Network:</b> {e_network}")
    lines += [
        "",
        f"<b>Diễn biến:</b> {e_summary}",
        "",
        f"<b>MITRE ATT&amp;CK:</b> {e_mitre}",
        "",
        f"<b>Threat Intel:</b> {e_verdict}",
    ]
    if intel_data.get("status") == "success":
        lines.append(f"    Tor: {e_is_tor} | Usage type: {e_usage_type}")
    if e_hashes:
        lines.append(f"<b>IOC Hash:</b> <code>{e_hashes}</code>")

    status_line = (
        f"Đã tự động chặn (AbuseIPDB score ≥ {AUTO_BLOCK_SCORE_THRESHOLD})"
        if auto_block else "⏳ Chờ analyst duyệt"
    )
    lines += [
        "",
        f"<b>Đề xuất xử lý:</b> {e_action_vi}",
        f"<b>Trạng thái:</b> {status_line}",
    ]
    if e_raw_log:
        lines += ["", f"<tg-spoiler>🔧 Raw log: <code>{e_raw_log}</code></tg-spoiler>"]
    lines += ["", f"<code>{incident_id}</code>"]

    telegram_text = "\n".join(lines)
    telegram_text = truncate_telegram_text(telegram_text)

    # 7. Nặn nút bấm SOAR chuẩn chỉnh cho thằng soar_backend.py hứng
    #
    # ⚠️ THAY ĐỔI QUAN TRỌNG (FIX #5):
    # callback_data giờ CHỈ chứa "approve_<incident_id>" hoặc "reject_<incident_id>",
    # KHÔNG còn nhét action/target/alert_id trực tiếp vào chuỗi nữa — vì:
    #   (a) tránh vượt giới hạn 64 byte của Telegram khi IP dài hoặc alert_id dài,
    #   (b) buộc backend phải đọc lại action/target từ chính file
    #       {incident_id}.json (trường "pending_action") — nơi đã được
    #       enforce_failsafe_actions() xử lý — thay vì tin vào một chuỗi
    #       callback có thể bị AI đề xuất sai.
    #
    # => soar_backend.py CẦN được cập nhật tương ứng để parse
    #    "approve_<incident_id>" / "reject_<incident_id>" và đọc
    #    REPORTS_DIR/<incident_id>.json để lấy action + target_ip.
    action = final_report["recommended_actions"][0] if final_report["recommended_actions"] else "monitor"
    target = final_report["pending_action"]["target_ip"]

    if auto_block:
        # Đã tự động chặn rồi — không cần Approve, chỉ cần 1 nút xác nhận đã đọc.
        dynamic_reply_markup = {
            "inline_keyboard": [[
                {
                    "text": f"☑️ Đã biết (tự động chặn {target})",
                    "callback_data": f"reject_{incident_id}",
                }
            ]]
        }
    elif action in ["block_ip", "isolate-machine"]:
        display_action_vi = ACTION_LABELS_VI.get(action, action).upper()
        dynamic_reply_markup = {
            "inline_keyboard": [[
                {
                    "text": f"✅ Duyệt {display_action_vi} ({target})",
                    "callback_data": f"approve_{incident_id}",
                },
                {
                    "text": "❌ Từ chối",
                    "callback_data": f"reject_{incident_id}",
                },
            ]]
        }
    else:
        dynamic_reply_markup = {
            "inline_keyboard": [[
                {
                    "text": "👁️ Đã xem & Theo dõi",
                    "callback_data": f"reject_{incident_id}",
                }
            ]]
        }

    # 8. Gửi payload sang Telegram qua Bot API công khai (có retry)
    tg_url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": telegram_text,
        "parse_mode": "HTML",
        "disable_web_page_preview": True,
        "reply_markup": dynamic_reply_markup,
    }

    tg_response = request_with_retry(
        "POST", tg_url, json=payload, timeout=REQUEST_TIMEOUT_TELEGRAM
    )
    if tg_response is None or tg_response.status_code != 200:
        status = tg_response.status_code if tg_response is not None else "no-response"
        body = tg_response.text[:300] if tg_response is not None else ""
        logging.error(f"Gửi Telegram thất bại (status={status}): {body}")

    # =====================================================================
    # 9. BẮN KÈM FILE JSON LÊN TELEGRAM (UPDATE CHO TN3)
    # =====================================================================
    doc_url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendDocument"
    try:
        report_path = os.path.join(REPORTS_DIR, f"{incident_id}.json")
        with open(report_path, "rb") as doc_file:
            doc_payload = {
                "chat_id": TELEGRAM_CHAT_ID,
                "caption": f"📄 Full Incident Report: {incident_id}"
            }
            doc_files = {
                "document": (f"{incident_id}.json", doc_file, "application/json")
            }
            requests.post(doc_url, data=doc_payload, files=doc_files, timeout=REQUEST_TIMEOUT_TELEGRAM)
    except Exception as e:
        logging.error(f"Lỗi khi gửi file JSON đính kèm lên Telegram: {e}")

if __name__ == "__main__":
    main()
