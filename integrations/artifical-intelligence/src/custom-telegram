def is_allowlisted(ip_str):
    """IP nằm trong INTERNAL_ALLOWLIST_CIDRS thì không bao giờ bị auto-block."""
    try:
        ip = ipaddress.ip_address(ip_str)
    except (ValueError, TypeError):
        return False
    for cidr in INTERNAL_ALLOWLIST_CIDRS:
        try:
            if ip in ipaddress.ip_network(cidr, strict=False):
                return True
        except ValueError:
            logging.warning(f"CIDR không hợp lệ trong INTERNAL_ALLOWLIST_CIDRS: {cidr}")
    return False


def should_auto_block(intel_data, src_ip):
    """
    Quyết định auto-block: score đủ cao + đủ report tối thiểu + IP public thật
    + không nằm trong allowlist. Đây là điều kiện DUY NHẤT quyết định block
    thẳng tay không qua người duyệt — cố tình để riêng thành 1 hàm để dễ audit/test.
    """
    if intel_data.get("status") != "success":
        return False
    if not is_public_ip(src_ip):
        return False
    if is_allowlisted(src_ip):
        logging.info(f"IP {src_ip} nằm trong allowlist nội bộ, bỏ qua auto-block.")
        return False
    score = intel_data.get("score", 0)
    total_reports = intel_data.get("total_reports", 0)
    return score >= AUTO_BLOCK_SCORE_THRESHOLD and total_reports >= AUTO_BLOCK_MIN_REPORTS


