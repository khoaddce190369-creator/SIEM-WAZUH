def is_public_ip(ip_str):
    """Kiểm tra IP Public hợp lệ, loại trừ IP LAN/Loopback"""
    try:
        ip = ipaddress.ip_address(ip_str)
        return ip.is_global
    except (ValueError, TypeError):
        return False


def request_with_retry(method, url, **kwargs):
    """
    FIX #7: Retry có backoff cho các API call quan trọng (AbuseIPDB, Telegram).
    Không retry vô hạn để tránh làm chậm pipeline alert.
    """
    last_exc = None
    for attempt in range(1, MAX_RETRIES + 2):  # thử lần đầu + MAX_RETRIES lần retry
        try:
            resp = requests.request(method, url, **kwargs)
            return resp
        except requests.exceptions.RequestException as e:
            last_exc = e
            logging.warning(
                f"Request tới {url} lỗi (lần {attempt}): {e}. "
                f"{'Thử lại...' if attempt <= MAX_RETRIES else 'Bỏ cuộc.'}"
            )
            if attempt <= MAX_RETRIES:
                time.sleep(RETRY_BACKOFF_SECONDS * attempt)
    logging.error(f"Request tới {url} thất bại sau {MAX_RETRIES + 1} lần thử: {last_exc}")
    return None


def get_abuseipdb_info(ip):
    """Gọi API AbuseIPDB trực tiếp trên luồng để lấy Threat Intel"""
    if not ip or not is_public_ip(ip):
        return {"status": "internal", "verdict": "Không có dữ liệu threat intelligence (IP nội bộ hoặc không xác định)."}

    if not ABUSEIPDB_API_KEY:
        logging.error("Thiếu ABUSEIPDB_API_KEY trong biến môi trường.")
        return {"status": "error", "verdict": "Không có dữ liệu threat intelligence (Thiếu cấu hình API key)."}

    url = "https://api.abuseipdb.com/api/v2/check"
    querystring = {"ipAddress": ip, "maxAgeInDays": "90"}
    headers = {"Accept": "application/json", "Key": ABUSEIPDB_API_KEY}

    response = request_with_retry(
        "GET", url, headers=headers, params=querystring, timeout=REQUEST_TIMEOUT_ABUSEIPDB
    )
    if response is not None and response.status_code == 200:
        data = response.json().get("data", {})
        return {
            "status": "success",
            "score": data.get("abuseConfidenceScore", 0),
            "total_reports": data.get("totalReports", 0),
            "is_tor": data.get("isTor", False),
            "isp": data.get("isp", "Unknown"),
            "usageType": data.get("usageType", "Unknown"),
            "country": data.get("countryCode", "Unknown"),
            "verdict": (
                f"AbuseIPDB Score: {data.get('abuseConfidenceScore', 0)}%. "
                f"Tổng số báo cáo: {data.get('totalReports', 0)}. "
                f"Quốc gia: {data.get('countryCode', 'Unknown')}. "
                f"ISP: {data.get('isp', 'Unknown')}."
            ),
        }

    return {"status": "error", "verdict": "Không có dữ liệu threat intelligence (Lỗi gọi API)."}


def get_next_incident_id() -> str:
    """
    FIX #4: Tự động sinh mã Incident ID dạng INC-YYYYMMDD-NNNN, có khóa file
    (fcntl.flock) để tránh race-condition khi nhiều alert bắn gần như đồng thời.
    """
    os.makedirs(REPORTS_DIR, exist_ok=True)
    lock_path = os.path.join(REPORTS_DIR, ".incident_id.lock")

    try:
        with open(lock_path, "a+") as lockfile:
            fcntl.flock(lockfile, fcntl.LOCK_EX)
            try:
                today_str = datetime.now().strftime("%Y%m%d")
                pattern = os.path.join(REPORTS_DIR, f"INC-{today_str}-*.json")
                existing_files = glob.glob(pattern)

                max_num = 0
                for f in existing_files:
                    try:
                        base = os.path.basename(f)
                        num_part = base.split("-")[2].split(".")[0]
                        max_num = max(max_num, int(num_part))
                    except (ValueError, IndexError):
                        continue
                return f"INC-{today_str}-{(max_num + 1):04d}"
            finally:
                fcntl.flock(lockfile, fcntl.LOCK_UN)
    except Exception as e:
        logging.error(f"Lỗi sinh ID sự cố: {e}")
        # Fallback: dùng timestamp microsecond để tối thiểu tránh trùng ID
        return f"INC-{datetime.now().strftime('%Y%m%d-%H%M%S%f')}"


def enforce_failsafe_actions(actions, attacker_ip):
    """
    FIX #3: Enforce lại rule fail-safe ở CODE, không tin tuyệt đối vào output của AI.
    Không bao giờ để lệnh block_ip lọt qua cho IP nội bộ / N/A.
    """
    if not isinstance(actions, list):
        actions = [actions] if actions else []

    # Whitelist: loại action lạ mà AI có thể "sáng tạo" ra
    actions = [a for a in actions if a in VALID_ACTIONS]
    if not actions:
        actions = ["monitor"]

    if "block_ip" in actions and not is_public_ip(attacker_ip):
        logging.warning(
            f"Fail-safe kích hoạt: AI đề xuất block_ip cho IP không hợp lệ/nội bộ "
            f"'{attacker_ip}'. Ép về isolate-machine."
        )
        actions = ["isolate-machine" if a == "block_ip" else a for a in actions]
        # loại trùng, giữ thứ tự
        seen = set()
        actions = [a for a in actions if not (a in seen or seen.add(a))]

    return actions


