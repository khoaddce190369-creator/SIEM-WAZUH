def truncate_telegram_text(text, limit=TELEGRAM_MAX_LEN):
    """FIX #8: Tránh Telegram từ chối message do vượt quá 4096 ký tự."""
    if len(text) <= limit:
        return text
    cut = text[: limit - 30].rstrip()
    return cut + "\n\n[...nội dung đã bị cắt bớt...]"


def format_timestamp_vn(ts_raw):
    """Convert timestamp Wazuh (thường là UTC) sang giờ VN (UTC+7) để SOC đọc
    khỏi nhầm giờ. Nếu parse lỗi, trả về giá trị gốc kèm ghi chú thay vì crash."""
    try:
        ts = ts_raw.strip()
        if ts.endswith("Z"):
            ts = ts[:-1] + "+00:00"
        else:
            # Wazuh thường xuất offset dạng "+0000"/"-0700" (không có dấu ":"),
            # nhưng datetime.fromisoformat() cần "+00:00" mới parse được.
            m = re.match(r"^(.*[+-]\d{2})(\d{2})$", ts)
            if m:
                ts = f"{m.group(1)}:{m.group(2)}"
        dt = datetime.fromisoformat(ts)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        dt_vn = dt.astimezone(VN_TZ)
        return dt_vn.strftime("%Y-%m-%d %H:%M:%S") + " (giờ VN, UTC+7)"
    except (ValueError, TypeError):
        return f"{ts_raw} (không parse được, giá trị gốc)"


def get_raw_log_excerpt(alert):
    """Trích đoạn log gốc (full_log) để SOC verify nhanh mà không cần SSH vào server."""
    raw = (alert.get("full_log") or "").strip()
    if not raw:
        return None
    if len(raw) > RAW_LOG_MAX_LEN:
        raw = raw[:RAW_LOG_MAX_LEN].rstrip() + "..."
    return raw


def extract_ioc_hashes(alert):
    """Lấy hash file từ sự kiện FIM (syscheck) nếu có — ưu tiên sha256 > sha1 > md5."""
    syscheck = alert.get("syscheck", {}) or {}
    for key in ("sha256_after", "sha1_after", "md5_after"):
        val = syscheck.get(key)
        if val:
            return [val]
    return []


def get_network_context(alert):
    """Lấy protocol/port từ alert.data nếu có, giúp phân biệt loại tấn công
    (vd: SSH brute-force vs web attack) mà không cần đọc raw log."""
    data = alert.get("data", {}) or {}
    protocol = data.get("protocol")
    srcport = data.get("srcport") or data.get("src_port")
    dstport = data.get("dstport") or data.get("dest_port")

    parts = []
    if protocol:
        parts.append(str(protocol).upper())
    if srcport:
        parts.append(f"src_port:{srcport}")
    if dstport:
        parts.append(f"dst_port:{dstport}")
    return " | ".join(parts) if parts else None


